# Copier en .env et remplir. Ne JAMAIS commit le fichier .env.

# --- Base de données (docker compose up -d) ---
DATABASE_URL="postgresql://microbeta:microbeta@localhost:5433/microbeta"
# Base des tests d'intégration (vidée à chaque run, jamais celle de dev)
TEST_DATABASE_URL="postgresql://microbeta:microbeta@localhost:5433/microbeta_test"

# --- Auth.js (site) ---
AUTH_SECRET=""                 # openssl rand -base64 32
AUTH_URL="http://localhost:3000"
AUTH_DISCORD_ID=""             # Discord Developer Portal > OAuth2
AUTH_DISCORD_SECRET=""

# --- Bot Discord (un bot de test PAR dev) ---
DISCORD_BOT_TOKEN=""
DISCORD_APPLICATION_ID=""
DISCORD_HUB_GUILD_ID=""        # serveur commun où les testeurs sont ajoutés

# --- Liens signés testeurs ---
TESTER_LINK_SECRET=""

# --- IA ---
ANTHROPIC_API_KEY=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""

# --- Email de secours ---
RESEND_API_KEY=""
EMAIL_FROM="MicroBeta <bot@example.com>"
